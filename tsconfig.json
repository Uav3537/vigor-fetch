{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "outDir": "./dist",
    "rootDir": "./src",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "stripInternal": true,
   "paths": {
      "@core/*": ["./src/core/*"],
      "@retry/*": ["./src/retry/*"],
      "@fetch/*": ["./src/fetch/*"],
      "@parse/*": ["./src/parse/*"],
      "@all/*": ["./src/all/*"],
      "@entry/*": ["./src/entry/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
