{
  "name": "vigor-fetch",
  "version": "4.0.5",
  "description": "Smart, zero-dependency HTTP client with self-healing retries for rate-limited servers.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/Uav3537/vigor-fetch.git"
  },
  "exports": {
    ".": {
      "types": {
        "require": "./dist/index.d.cts",
        "import": "./dist/index.d.ts"
      },
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "test": "node test.js"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "fetch",
    "fetch retry",
    "concurrency",
    "retry",
    "backoff",
    "ratelimit",
    "hooks",
    "typescript",
    "zero-dependency",
    "resilient HTTP client"
  ],
  "author": "Uav1010",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^5.8.3"
  },
  "type": "module"
}
